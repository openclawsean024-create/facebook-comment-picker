# Facebook App 設定（去 https://developers.facebook.com/apps 建一個 App）
# 這份是範例檔，**不要 commit 真實 secret**
# 部署到 Vercel 時，請到 Vercel Dashboard → Project → Settings → Environment Variables 設定

# Vite 前端用（VITE_ 前綴才會被打進 bundle）
# App ID 是公開的，可以放 .env.example
VITE_FB_APP_ID=YOUR_APP_ID_HERE

# Serverless API 用（僅 server-side，不會外洩）
FACEBOOK_APP_ID=YOUR_APP_ID_HERE
FACEBOOK_APP_SECRET=YOUR_APP_SECRET_HERE

# OAuth Redirect URI（部署到 Vercel 後改成實際域名）
# 本地開發：http://localhost:5173/api/facebook/callback
# Vercel production：https://fb-giveaway-v2.vercel.app/api/facebook/callback
FACEBOOK_REDIRECT_URI=https://fb-giveaway-v2.vercel.app/api/facebook/callback

# OPTIONAL: 預先準備好的粉專 long-lived page token（可繞過 OAuth 直接拉特定粉專留言）
# 用途：CI / 自動化抽獎工具使用
# 取得：先用 OAuth 拿到 user token，再呼叫 /me/accounts 拿 page token
# FACEBOOK_PAGE_ACCESS_TOKEN=

# OPTIONAL: RapidAPI fallback（fetch-comments.js 走 r.jina.ai 之外的後備）
# 用途：當 Graph API 失敗時可改走 RapidAPI Facebook scraper
# RAPID_API_KEY=
